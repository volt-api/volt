  "item": [
    {
      "name": "users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/{{api_version}}/users?page=1&limit=50" },
            "header": [
              { "key": "Accept", "value": "application/json" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/{{api_version}}/users/{{user_id}}" },
            "header": [
              { "key": "Accept", "value": "application/json" }
            ]
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/{{api_version}}/users" },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"{{user_name}}\", \"email\": \"{{user_email}}\", \"role\": \"member\"}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"User created\", function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.environment.set(\"user_id\", jsonData.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/{{api_version}}/users/{{user_id}}" },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Updated Name\", \"email\": \"updated@enterprise.io\"}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Patch User Role",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{base_url}}/{{api_version}}/users/{{user_id}}/role" },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"role\": \"admin\"}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/{{api_version}}/users/{{user_id}}" }
          }
        },
        {
          "name": "Search Users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/{{api_version}}/users/search?q={{search_query}}&sort=name" }
          }
        },
        {
          "name": "User Avatar Upload",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/{{api_version}}/users/{{user_id}}/avatar" },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "avatar", "value": "profile.png", "type": "file" },
                { "key": "resize", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "List User Activity",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/{{api_version}}/users/{{user_id}}/activity" }
          }
        },
        {
          "name": "Bulk Import Users",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/{{api_version}}/users/bulk" },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[{\"name\":\"Alice\"},{\"name\":\"Bob\"},{\"name\":\"Charlie\"}]",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
