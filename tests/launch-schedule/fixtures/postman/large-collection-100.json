                  "pm.test(\"Webhook created\", function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.environment.set(\"webhook_id\", jsonData.id);"
                ]
              }
