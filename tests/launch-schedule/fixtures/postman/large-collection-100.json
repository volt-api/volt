          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set(\"check_time\", \"{{$timestamp}}\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Health OK\", function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.response.to.have.header(\"Content-Type\");"
                ]
              }
            }
          ]
        }
